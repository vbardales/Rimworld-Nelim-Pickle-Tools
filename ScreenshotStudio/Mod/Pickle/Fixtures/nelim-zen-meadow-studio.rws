							<deities>
								<li>
									<name>Dir</name>
									<type>Master of creation</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_TheistEmbodied</relatedMeme>
								</li>
								<li>
									<name>Vereucus</name>
									<type>Goddess of space</type>
