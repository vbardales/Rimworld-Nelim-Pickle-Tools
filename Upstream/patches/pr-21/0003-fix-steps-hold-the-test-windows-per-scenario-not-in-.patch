From 7280f5fedeb6736db04b6c7c66b253793a05fda8 Mon Sep 17 00:00:00 2001
From: vbardales <virginie.bardales@gmail.com>
Date: Mon, 21 Sep 2026 11:41:07 +0200
Subject: [PATCH 3/4] fix(steps): hold the test windows per scenario, not in
 statics

The analyzer gate fails on S2696: instance methods must not write static
fields. It is right here - a steps class is built once per scenario and
cached, so instance fields already are the per-scenario state these needed,
and nothing carries into the next scenario.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Source/Pickle/Runtime/WindowSuppressionSteps.cs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Source/Pickle/Runtime/WindowSuppressionSteps.cs b/Source/Pickle/Runtime/WindowSuppressionSteps.cs
index b6120ca..ca10b63 100644
--- a/Source/Pickle/Runtime/WindowSuppressionSteps.cs
+++ b/Source/Pickle/Runtime/WindowSuppressionSteps.cs
@@ -14,8 +14,10 @@ namespace RimWorks.Pickle.Runtime;
 // would do nothing and the scenario would read a stale result as a pass.
 [PickleSteps]
 public class WindowSuppressionSteps {
-  private static Dialog_MessageBox? foreign;
-  private static TagClickTestWindow? own;
+  // One instance of a steps class serves one scenario, so these hold that scenario's windows
+  // and nothing leaks into the next one.
+  private Dialog_MessageBox? foreign;
+  private TagClickTestWindow? own;
 
   /// <summary>Opens a window belonging to the game, which suppression is meant to drop.</summary>
   /// <param name="ctx">The scenario's context, for assertions, requirements, and waits.</param>
-- 
2.52.0.windows.1

