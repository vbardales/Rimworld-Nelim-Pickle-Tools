--- /dev/null
+++ b/Source/Pickle.Core/Run/FilmTickGate.cs
@@ -0,0 +1,39 @@
+using System;
+
+namespace RimWorks.Pickle.Core.Run;
+
+/// <summary>
+/// Decides, frame by frame, when a film that counts in game ticks takes its next picture.
+/// A film paced by the clock samples whatever the screen shows at that moment, so an effect that
+/// lives one tick in fifteen is caught by chance. This gate is fed the tick counter on every
+/// rendered frame and answers true once the counter has moved on by the requested number of ticks.
+/// </summary>
+public sealed class FilmTickGate {
+  private readonly int ticksPerFrame;
+
+  private int? lastCapturedTick;
+
+  /// <summary>Initializes a new instance.</summary>
+  /// <param name="ticksPerFrame">How many game ticks pass between two pictures. At least one.</param>
+  public FilmTickGate(int ticksPerFrame) {
+    if (ticksPerFrame < 1) {
+      throw new ArgumentOutOfRangeException(nameof(ticksPerFrame), ticksPerFrame, "A film needs at least one tick between pictures.");
+    }
+
+    this.ticksPerFrame = ticksPerFrame;
+  }
+
+  /// <summary>Whether this frame is one to capture, remembering it if so.</summary>
+  /// <param name="ticksGame">The game's tick counter as this frame is drawn.</param>
+  /// <returns><c>true</c> for the first frame and whenever the counter has advanced far enough.</returns>
+  // A counter that has gone backwards means a load or a debug rewind: the remembered tick is
+  // meaningless, so take the picture and start counting again from there.
+  public bool ShouldCapture(int ticksGame) {
+    if (lastCapturedTick is int last && ticksGame >= last && ticksGame - last < ticksPerFrame) {
+      return false;
+    }
+
+    lastCapturedTick = ticksGame;
+    return true;
+  }
+}
diff --git a/Source/Pickle.Tests/FilmTickGateTests.cs b/Source/Pickle.Tests/FilmTickGateTests.cs
new file mode 100644
index 0000000..af9dfa9
--- /dev/null
+++ b/Source/Pickle.Tests/FilmTickGateTests.cs
@@ -0,0 +1,65 @@
+using System;
+using RimWorks.Pickle.Core.Run;
+using Xunit;
+
+namespace RimWorks.Pickle.Tests;
+
+public class FilmTickGateTests {
+  [Fact]
+  public void ShouldCapture_FirstFrameAlwaysCaptures() {
+    FilmTickGate gate = new(5);
+
+    Assert.True(gate.ShouldCapture(1000));
+  }
+
+  [Fact]
+  public void ShouldCapture_OneTickCapturesEveryTickThatPasses() {
+    FilmTickGate gate = new(1);
+
+    Assert.True(gate.ShouldCapture(10));
+    Assert.False(gate.ShouldCapture(10));
+    Assert.True(gate.ShouldCapture(11));
+    Assert.True(gate.ShouldCapture(12));
+  }
+
+  [Fact]
+  public void ShouldCapture_WaitsUntilTheCounterHasAdvancedFarEnough() {
+    FilmTickGate gate = new(15);
+
+    Assert.True(gate.ShouldCapture(100));
+    Assert.False(gate.ShouldCapture(101));
+    Assert.False(gate.ShouldCapture(114));
+    Assert.True(gate.ShouldCapture(115));
+    Assert.False(gate.ShouldCapture(129));
+    Assert.True(gate.ShouldCapture(130));
+  }
+
+  [Fact]
+  public void ShouldCapture_CountsFromTheTickItCapturedNotFromTheOneItWasDue() {
+    // The frame that finally notices a boundary may land late. The next picture is due
+    // ticksPerFrame after the one taken, so a slow frame does not shorten the next gap.
+    FilmTickGate gate = new(10);
+
+    Assert.True(gate.ShouldCapture(0));
+    Assert.True(gate.ShouldCapture(13));
+    Assert.False(gate.ShouldCapture(22));
+    Assert.True(gate.ShouldCapture(23));
+  }
+
+  [Fact]
+  public void ShouldCapture_CounterGoingBackwardsCapturesAndRestarts() {
+    FilmTickGate gate = new(10);
+
+    Assert.True(gate.ShouldCapture(500));
+    Assert.True(gate.ShouldCapture(20));
+    Assert.False(gate.ShouldCapture(25));
+    Assert.True(gate.ShouldCapture(30));
+  }
+
+  [Theory]
+  [InlineData(0)]
+  [InlineData(-3)]
+  public void Constructor_RejectsAnIntervalUnderOneTick(int ticksPerFrame) {
+    Assert.Throws<ArgumentOutOfRangeException>(() => new FilmTickGate(ticksPerFrame));
+  }
+}
