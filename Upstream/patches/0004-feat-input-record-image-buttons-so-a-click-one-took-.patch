+  [Fact]
+  public void ControlsAt_ListsOnceAControlEveryOverloadOfItsWidgetReported() {
+    var box = new ScreenBox(1740f, 45f, 20f, 20f);
+    DrawnControl[] drawn = [
+        new("ButtonImage", null, box, 4),
+        new("ButtonImage", null, box, 5),
+        new("ButtonText", "Same place", box, 6),
+    ];
+
+    IReadOnlyList<DrawnControl> under = LostClickReport.ControlsAt(drawn, 1750f, 55f);
+
+    Assert.Equal([4, 6], [.. under.Select(c => c.Order)]);
+  }
+
   [Fact]
   public void Format_NamesTheClickTheRecordedRectAndTheThreePointerReadings() {
     string text = Report([], []);
diff --git a/Source/Pickle/Patching/PickleHooks.cs b/Source/Pickle/Patching/PickleHooks.cs
index 52bd810..8bd7a9d 100644
--- a/Source/Pickle/Patching/PickleHooks.cs
+++ b/Source/Pickle/Patching/PickleHooks.cs
@@ -42,6 +42,12 @@ public static class PickleHooks {
     WidgetCapture.AfterButtonText(rect, label);
   }
 
+  /// <summary>Runs after any <c>Widgets.ButtonImage*</c> overload draws, letting <see cref="DrawnControls"/> record it so a click it took can be explained.</summary>
+  /// <param name="butRect">The rect the button occupies.</param>
+  public static void AfterButtonImage(Rect butRect) {
+    DrawnControls.Record("ButtonImage", null, butRect);
+  }
+
   /// <summary>
   /// False drops the window. Autorun suppresses windows opened while a fixture loads.
   /// </summary>
