+using System.Collections.Generic;
+using RimWorks.Pickle.Core.Ui;
+using UnityEngine;
+
+namespace RimWorks.Pickle.Input;
+
+/// <summary>
+/// Every control Pickle saw drawn in the last frame, in draw order. <see cref="TagStore"/> keeps one
+/// rect per tag and forgets the order, so it cannot say which controls hold a point; a click that
+/// opened nothing needs exactly that.
+/// </summary>
+internal static class DrawnControls {
+  private static readonly List<DrawnControl> Drawn = [];
+
+  public static IReadOnlyList<DrawnControl> All => Drawn;
+
+  public static void Record(string widget, string? label, Rect rect) {
+    if (!TagStore.SessionActive) {
+      return;
+    }
+
+    // Same gate and same conversion as TagStore.Record, so a rect kept here and one kept there
+    // are in one space and can be compared.
+    if (Event.current == null || Event.current.type != EventType.Repaint) {
+      return;
+    }
+
+    Rect screenRect = GUIUtility.GUIToScreenRect(rect);
+    Drawn.Add(new DrawnControl(widget, label, new ScreenBox(screenRect.x, screenRect.y, screenRect.width, screenRect.height), Drawn.Count));
+  }
+
+  public static void BeginFrame() {
+    Drawn.Clear();
+  }
+}
