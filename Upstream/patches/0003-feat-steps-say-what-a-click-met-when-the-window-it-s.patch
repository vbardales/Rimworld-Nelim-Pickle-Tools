--- /dev/null
+++ b/Source/Pickle.Core/Ui/ClickRecords.cs
@@ -0,0 +1,172 @@
+namespace RimWorks.Pickle.Core.Ui;
+
+/// <summary>A rectangle in the space Pickle records tags in, with the same half-open edges as Unity's <c>Rect</c>.</summary>
+public readonly struct ScreenBox {
+  /// <summary>Creates a box from its top-left corner and its size.</summary>
+  /// <param name="x">Left edge.</param>
+  /// <param name="y">Top edge.</param>
+  /// <param name="width">Width.</param>
+  /// <param name="height">Height.</param>
+  public ScreenBox(float x, float y, float width, float height) {
+    X = x;
+    Y = y;
+    Width = width;
+    Height = height;
+  }
+
+  /// <summary>Left edge.</summary>
+  public float X { get; }
+
+  /// <summary>Top edge.</summary>
+  public float Y { get; }
+
+  /// <summary>Width.</summary>
+  public float Width { get; }
+
+  /// <summary>Height.</summary>
+  public float Height { get; }
+
+  /// <summary>Horizontal centre, the point a click on this box lands on.</summary>
+  public float CenterX => X + (Width / 2f);
+
+  /// <summary>Vertical centre, the point a click on this box lands on.</summary>
+  public float CenterY => Y + (Height / 2f);
+
+  /// <summary>True when the point is inside; the right and bottom edges are outside, as in Unity.</summary>
+  /// <param name="pointX">The point's horizontal position.</param>
+  /// <param name="pointY">The point's vertical position.</param>
+  /// <returns>Whether the box holds the point.</returns>
+  public bool Contains(float pointX, float pointY) {
+    return pointX >= X && pointX < X + Width && pointY >= Y && pointY < Y + Height;
+  }
+
+  /// <inheritdoc/>
+  public override string ToString() {
+    return "(x " + LostClickReport.Num(X) + ", y " + LostClickReport.Num(Y) + ", w " + LostClickReport.Num(Width) + ", h " + LostClickReport.Num(Height) + ")";
+  }
+}
+
+/// <summary>A control that was drawn during a frame, in the order it was drawn.</summary>
+public sealed class DrawnControl {
+  /// <summary>Creates a record of one drawn control.</summary>
+  /// <param name="widget">The widget method that drew it, such as <c>ButtonText</c>.</param>
+  /// <param name="label">Its text, or null for a control that has none.</param>
+  /// <param name="box">Where it was drawn.</param>
+  /// <param name="order">Its position in that frame's draw order, first drawn is 0.</param>
+  public DrawnControl(string widget, string? label, ScreenBox box, int order) {
+    Widget = widget;
+    Label = label;
+    Box = box;
+    Order = order;
+  }
+
+  /// <summary>The widget method that drew it, such as <c>ButtonText</c>.</summary>
+  public string Widget { get; }
+
+  /// <summary>Its text, or null for a control that has none.</summary>
+  public string? Label { get; }
+
+  /// <summary>Where it was drawn.</summary>
+  public ScreenBox Box { get; }
+
+  /// <summary>Its position in that frame's draw order, first drawn is 0.</summary>
+  public int Order { get; }
+}
+
+/// <summary>One window of the stack and what decides whether a click reaches it.</summary>
+public sealed class StackedWindow {
+  /// <summary>Creates a record of one window.</summary>
+  /// <param name="index">Its position in the stack, the last one is on top.</param>
+  /// <param name="typeName">The window's type name.</param>
+  /// <param name="assemblyName">The assembly the window's type comes from.</param>
+  /// <param name="layer">The window layer it is drawn on.</param>
+  /// <param name="box">Its rectangle.</param>
+  /// <param name="absorbsInput">Whether it absorbs input around itself.</param>
+  /// <param name="getsInput">Whether the game would deliver a click to it.</param>
+  /// <param name="holdsPointer">Whether its rectangle holds the pointer.</param>
+  /// <param name="drawnBy">For a window that carries no identity of its own, the method that draws it.</param>
+  public StackedWindow(
+      int index,
+      string typeName,
+      string assemblyName,
+      string layer,
+      ScreenBox box,
+      bool absorbsInput,
+      bool getsInput,
+      bool holdsPointer,
+      string? drawnBy) {
+    Index = index;
+    TypeName = typeName;
+    AssemblyName = assemblyName;
+    Layer = layer;
+    Box = box;
+    AbsorbsInput = absorbsInput;
+    GetsInput = getsInput;
+    HoldsPointer = holdsPointer;
+    DrawnBy = drawnBy;
+  }
+
+  /// <summary>Its position in the stack, the last one is on top.</summary>
+  public int Index { get; }
+
+  /// <summary>The window's type name.</summary>
+  public string TypeName { get; }
+
+  /// <summary>The assembly the window's type comes from.</summary>
+  public string AssemblyName { get; }
+
+  /// <summary>The window layer it is drawn on.</summary>
+  public string Layer { get; }
+
+  /// <summary>Its rectangle.</summary>
+  public ScreenBox Box { get; }
+
+  /// <summary>Whether it absorbs input around itself.</summary>
+  public bool AbsorbsInput { get; }
+
+  /// <summary>Whether the game would deliver a click to it.</summary>
+  public bool GetsInput { get; }
+
+  /// <summary>Whether its rectangle holds the pointer.</summary>
+  public bool HoldsPointer { get; }
+
+  /// <summary>For a window that carries no identity of its own, the method that draws it.</summary>
+  public string? DrawnBy { get; }
+}
+
+/// <summary>What a click step did, kept so a later failure can say where it landed.</summary>
+public sealed class ClickAttempt {
+  /// <summary>Creates a record of one click.</summary>
+  /// <param name="tag">The tag that was clicked.</param>
+  /// <param name="recorded">The rectangle Pickle had recorded for the tag; the click goes to its centre.</param>
+  /// <param name="pointerBefore">Where the game read the pointer before the click.</param>
+  /// <param name="pointerAfter">Where the game read the pointer once the click was sent.</param>
+  /// <param name="frameAtClick">The frame count when the click was sent.</param>
+  public ClickAttempt(
+      string tag,
+      ScreenBox recorded,
+      (float X, float Y) pointerBefore,
+      (float X, float Y) pointerAfter,
+      int frameAtClick) {
+    Tag = tag;
+    Recorded = recorded;
+    PointerBefore = pointerBefore;
+    PointerAfter = pointerAfter;
+    FrameAtClick = frameAtClick;
+  }
+
+  /// <summary>The tag that was clicked.</summary>
+  public string Tag { get; }
+
+  /// <summary>The rectangle Pickle had recorded for the tag; the click goes to its centre.</summary>
+  public ScreenBox Recorded { get; }
+
+  /// <summary>Where the game read the pointer before the click.</summary>
+  public (float X, float Y) PointerBefore { get; }
+
+  /// <summary>Where the game read the pointer once the click was sent.</summary>
+  public (float X, float Y) PointerAfter { get; }
+
+  /// <summary>The frame count when the click was sent.</summary>
+  public int FrameAtClick { get; }
+}
diff --git a/Source/Pickle.Core/Ui/LostClickReport.cs b/Source/Pickle.Core/Ui/LostClickReport.cs
new file mode 100644
index 0000000..ef50779
--- /dev/null
+++ b/Source/Pickle.Core/Ui/LostClickReport.cs
@@ -0,0 +1,101 @@
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text;
+
+namespace RimWorks.Pickle.Core.Ui;
+
+/// <summary>
+/// Writes what a click met when it opened nothing: where the pointer was, which drawn controls hold
+/// it, and the window stack with what decides whether each window receives input. It states facts
+/// and names no cause. Pure so it stays unit testable; the game side only gathers the inputs.
+/// </summary>
+public static class LostClickReport {
+  /// <summary>The controls whose rectangle holds a point, in the order they were drawn.</summary>
+  /// <param name="drawn">Every control drawn in the frame.</param>
+  /// <param name="x">The point's horizontal position.</param>
+  /// <param name="y">The point's vertical position.</param>
+  /// <returns>The controls under the point, first drawn first.</returns>
+  public static IReadOnlyList<DrawnControl> ControlsAt(IEnumerable<DrawnControl> drawn, float x, float y) {
+    return [.. drawn.Where(control => control.Box.Contains(x, y)).OrderBy(control => control.Order)];
+  }
+
+  /// <summary>Formats the report.</summary>
+  /// <param name="click">The last click of the scenario.</param>
+  /// <param name="pointerNow">Where the game reads the pointer now.</param>
+  /// <param name="framesSince">How many frames have passed since the click.</param>
+  /// <param name="drawn">Every control drawn in the last frame.</param>
+  /// <param name="windows">The window stack, bottom first, as the game holds it.</param>
+  /// <returns>Several lines of text, none of them a conclusion.</returns>
+  public static string Format(
+      ClickAttempt click,
+      (float X, float Y) pointerNow,
+      int framesSince,
+      IReadOnlyList<DrawnControl> drawn,
+      IReadOnlyList<StackedWindow> windows) {
+    var text = new StringBuilder();
+
+    text.Append("the last click of this scenario was on '").Append(click.Tag).Append("', ")
+        .Append(framesSince.ToString(CultureInfo.InvariantCulture)).AppendLine(" frame(s) ago");
+    text.Append("  Pickle recorded the tag at ").Append(click.Recorded)
+        .Append(", centre ").AppendLine(Point((click.Recorded.CenterX, click.Recorded.CenterY)));
+    text.Append("  pointer before the click ").Append(Point(click.PointerBefore))
+        .Append(", after it ").Append(Point(click.PointerAfter))
+        .Append(", now ").AppendLine(Point(pointerNow));
+
+    IReadOnlyList<DrawnControl> under = ControlsAt(drawn, pointerNow.X, pointerNow.Y);
+    text.AppendLine("controls drawn under the pointer, in draw order:");
+    if (under.Count == 0) {
+      text.AppendLine("  none");
+    }
+
+    foreach (DrawnControl control in under) {
+      text.Append("  ").Append(control.Widget);
+      if (control.Label != null) {
+        text.Append(" '").Append(control.Label).Append('\'');
+      }
+
+      text.Append(" at ").Append(control.Box).Append(", drawn #")
+          .AppendLine(control.Order.ToString(CultureInfo.InvariantCulture));
+    }
+
+    text.AppendLine("windows, top first:");
+    if (windows.Count == 0) {
+      text.Append("  none");
+    }
+
+    int top = windows.Count == 0 ? -1 : windows.Max(w => w.Index);
+    foreach (StackedWindow window in windows.OrderByDescending(w => w.Index)) {
+      text.Append("  #").Append(window.Index.ToString(CultureInfo.InvariantCulture));
+      if (window.Index == top) {
+        text.Append(" top");
+      }
+
+      text.Append(' ').Append(window.TypeName).Append(" [").Append(window.AssemblyName).Append("] layer=")
+          .Append(window.Layer).Append(" rect=").Append(window.Box)
+          .Append(" absorbInputAroundWindow=").Append(Flag(window.AbsorbsInput))
+          .Append(" getsInput=").Append(Flag(window.GetsInput))
+          .Append(" holdsPointer=").Append(Flag(window.HoldsPointer));
+
+      if (window.DrawnBy != null) {
+        text.Append(" drawnBy=").Append(window.DrawnBy);
+      }
+
+      text.AppendLine();
+    }
+
+    return text.ToString().TrimEnd();
+  }
+
+  internal static string Num(float value) {
+    return value.ToString("0.##", CultureInfo.InvariantCulture);
+  }
+
+  private static string Flag(bool value) {
+    return value ? "true" : "false";
+  }
+
+  private static string Point((float X, float Y) point) {
+    return "(" + LostClickReport.Num(point.X) + ", " + LostClickReport.Num(point.Y) + ")";
+  }
+}
diff --git a/Source/Pickle.Tests/LostClickReportTests.cs b/Source/Pickle.Tests/LostClickReportTests.cs
