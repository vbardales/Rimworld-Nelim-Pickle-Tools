@@ -0,0 +1,128 @@
+using System.Collections.Generic;
+using System.Linq;
+using RimWorks.Pickle.Core.Ui;
+using Xunit;
+
+namespace RimWorks.Pickle.Tests;
+
+public class LostClickReportTests {
+  private static readonly ClickAttempt Click = new(
+      "btn:Work types...",
+      new ScreenBox(1700f, 40f, 100f, 30f),
+      (10f, 20f),
+      (1750f, 55f),
+      100);
+
+  private static StackedWindow Window(int index, string type, bool absorbs, bool gets, bool holds, string? drawnBy = null) {
+    return new StackedWindow(index, type, "Assembly-CSharp", "GameUI", new ScreenBox(0f, 0f, 200f, 100f), absorbs, gets, holds, drawnBy);
+  }
+
+  private static string Report(IReadOnlyList<DrawnControl> drawn, IReadOnlyList<StackedWindow> windows) {
+    return LostClickReport.Format(Click, (1750f, 55f), 300, drawn, windows);
+  }
+
+  [Fact]
+  public void ScreenBox_Contains_TreatsRightAndBottomEdgesAsOutside() {
+    var box = new ScreenBox(10f, 10f, 20f, 20f);
+
+    Assert.True(box.Contains(10f, 10f));
+    Assert.True(box.Contains(29.9f, 29.9f));
+    Assert.False(box.Contains(30f, 15f));
+    Assert.False(box.Contains(15f, 30f));
+    Assert.False(box.Contains(9.9f, 15f));
+  }
+
+  [Fact]
+  public void ScreenBox_Centre_IsTheMiddle() {
+    var box = new ScreenBox(1700f, 40f, 100f, 30f);
+
+    Assert.Equal(1750f, box.CenterX);
+    Assert.Equal(55f, box.CenterY);
+  }
+
+  [Fact]
+  public void ControlsAt_KeepsOnlyControlsHoldingThePointerInDrawOrder() {
+    DrawnControl[] drawn = [
+        new("ButtonImage", null, new ScreenBox(1740f, 45f, 20f, 20f), 7),
+        new("ButtonText", "Elsewhere", new ScreenBox(0f, 0f, 50f, 50f), 3),
+        new("ButtonText", "Work types...", new ScreenBox(1700f, 40f, 100f, 30f), 2),
+    ];
+
+    IReadOnlyList<DrawnControl> under = LostClickReport.ControlsAt(drawn, 1750f, 55f);
+
+    Assert.Equal([2, 7], [.. under.Select(c => c.Order)]);
+  }
+
+  [Fact]
+  public void Format_NamesTheClickTheRecordedRectAndTheThreePointerReadings() {
+    string text = Report([], []);
+
+    Assert.Contains("'btn:Work types...'", text);
+    Assert.Contains("300 frame(s) ago", text);
+    Assert.Contains("(x 1700, y 40, w 100, h 30), centre (1750, 55)", text);
+    Assert.Contains("pointer before the click (10, 20), after it (1750, 55), now (1750, 55)", text);
+  }
+
+  [Fact]
+  public void Format_WithNothingUnderThePointerAndNoWindow_SaysNone() {
+    string text = Report([], []);
+
+    Assert.Contains("controls drawn under the pointer, in draw order:\n  none", text.Replace("\r\n", "\n"));
+    Assert.EndsWith("windows, top first:\n  none", text.Replace("\r\n", "\n"));
+  }
+
+  [Fact]
+  public void Format_ListsControlsUnderThePointerWithWidgetLabelAndDrawOrder() {
+    DrawnControl[] drawn = [
+        new("ButtonText", "Work types...", new ScreenBox(1700f, 40f, 100f, 30f), 2),
+        new("ButtonImage", null, new ScreenBox(1740f, 45f, 20f, 20f), 7),
+    ];
+
+    string text = Report(drawn, []);
+
+    Assert.Contains("ButtonText 'Work types...' at (x 1700, y 40, w 100, h 30), drawn #2", text);
+    Assert.Contains("ButtonImage at (x 1740, y 45, w 20, h 20), drawn #7", text);
+    Assert.True(text.IndexOf("drawn #2", System.StringComparison.Ordinal) < text.IndexOf("drawn #7", System.StringComparison.Ordinal));
+  }
+
+  [Fact]
+  public void Format_ListsWindowsTopFirstAndMarksTheTop() {
+    StackedWindow[] windows = [
+        Window(0, "MainTabWindow_Work", false, false, true),
+        Window(1, "ImmediateWindow", true, true, false, "Some.Mod.Overlay+<>c.Draw [SomeMod]"),
+    ];
+
+    string text = Report([], windows);
+
+    Assert.True(text.IndexOf("#1 top ImmediateWindow", System.StringComparison.Ordinal)
+        < text.IndexOf("#0 MainTabWindow_Work", System.StringComparison.Ordinal));
+    Assert.DoesNotContain("#0 top", text);
+  }
+
+  [Fact]
+  public void Format_ReportsWhatDecidesWhetherAWindowReceivesInput() {
+    string text = Report([], [Window(0, "MainTabWindow_Work", true, false, true)]);
+
+    Assert.Contains("[Assembly-CSharp] layer=GameUI rect=(x 0, y 0, w 200, h 100)", text);
+    Assert.Contains("absorbInputAroundWindow=true getsInput=false holdsPointer=true", text);
+  }
+
+  [Fact]
+  public void Format_NamesTheDrawingMethodOfAnImmediateWindowOnly() {
+    string text = Report([], [
+        Window(0, "Dialog_Plain", false, true, false),
+        Window(1, "ImmediateWindow", false, true, false, "Some.Mod.Overlay.Draw [SomeMod]"),
+    ]);
+
+    Assert.Contains("drawnBy=Some.Mod.Overlay.Draw [SomeMod]", text);
+    Assert.Equal(1, text.Split(["drawnBy="], System.StringSplitOptions.None).Length - 1);
+  }
+
+  [Fact]
+  public void Format_StatesNoCause() {
+    string text = Report([], [Window(0, "ImmediateWindow", true, true, true)]);
+
+    Assert.DoesNotContain("because", text);
+    Assert.DoesNotContain("swallow", text);
+  }
+}
