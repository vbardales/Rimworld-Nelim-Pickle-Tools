diff --git a/Source/Pickle/Input/ClickReport.cs b/Source/Pickle/Input/ClickReport.cs
new file mode 100644
index 0000000..1ba3bd6
--- /dev/null
+++ b/Source/Pickle/Input/ClickReport.cs
@@ -0,0 +1,57 @@
+using System.Collections.Generic;
+using RimWorks.Pickle.Core.Ui;
+using UnityEngine;
+using Verse;
+
+namespace RimWorks.Pickle.Input;
+
+/// <summary>Gathers, from the running game, what <see cref="LostClickReport"/> writes about.</summary>
+internal static class ClickReport {
+  public static ClickAttempt Attempt(string tag, Rect recorded, Vector2 before, int frame) {
+    Vector2 after = Verse.UI.MousePositionOnUIInverted;
+    return new ClickAttempt(
+        tag,
+        new ScreenBox(recorded.x, recorded.y, recorded.width, recorded.height),
+        (before.x, before.y),
+        (after.x, after.y),
+        frame);
+  }
+
+  public static string Describe(ClickAttempt click) {
+    Vector2 pointer = Verse.UI.MousePositionOnUIInverted;
+    return LostClickReport.Format(click, (pointer.x, pointer.y), Time.frameCount - click.FrameAtClick, DrawnControls.All, Windows(pointer));
+  }
+
+  private static List<StackedWindow> Windows(Vector2 pointer) {
+    WindowStack stack = Find.WindowStack;
+    var windows = new List<StackedWindow>();
+
+    for (int i = 0; i < stack.Windows.Count; i++) {
+      Window window = stack.Windows[i];
+      Rect rect = window.windowRect;
+      windows.Add(new StackedWindow(
+          i,
+          window.GetType().Name,
+          window.GetType().Assembly.GetName().Name,
+          window.layer.ToString(),
+          new ScreenBox(rect.x, rect.y, rect.width, rect.height),
+          window.absorbInputAroundWindow,
+          stack.GetsInput(window),
+          rect.Contains(pointer),
+          DrawnBy(window)));
+    }
+
+    return windows;
+  }
+
+  // An ImmediateWindow carries no identity of its own: two of them read the same in a list of open
+  // windows. The method that draws it is what tells them apart, and its assembly says whose it is.
+  private static string? DrawnBy(Window window) {
+    if (window is not ImmediateWindow { doWindowFunc: { } draw }) {
+      return null;
+    }
+
+    System.Reflection.MethodInfo method = draw.Method;
+    return $"{method.DeclaringType?.FullName}.{method.Name} [{method.DeclaringType?.Assembly.GetName().Name}]";
+  }
+}
