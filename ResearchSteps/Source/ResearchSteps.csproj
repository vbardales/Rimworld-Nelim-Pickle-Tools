<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reusable Pickle steps that open a tab of the research window by def name, by label or by translation key,
    and read what it lists. Only Pickle loads this assembly: it lives in a companion mod, never in a mod that
    goes to the Workshop. A suite stages it with one line in a pass map, see ../README.md.

    Same build as ../../Source/RimmsqolSteps.csproj: compile-time stubs only, the game, Harmony and the Pickle
    mod supply the real assemblies at run time.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Nelim.PickleTools.ResearchSteps</AssemblyName>
    <RootNamespace>Nelim.PickleTools.Research</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
