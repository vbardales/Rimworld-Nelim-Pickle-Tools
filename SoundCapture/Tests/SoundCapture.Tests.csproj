<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analysis has no game in it, so it is tested on plain .NET. The file is linked, not copied: the test runs
       the very source the steps assembly compiles. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\SoundAnalysis.cs" Link="SoundAnalysis.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

</Project>
