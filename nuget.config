<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Temporary (2026-11-19): RimWorks.Pickle.Ref 6.7.x on nuget.org carries net10.0 only, so a net472 project cannot restore it (NU1202).
       The local feed holds Ref 6.7.5 rebuilt from the upstream tag v6.7.5 for net472 (GameVersion=1.6), version 6.7.5-net472.1.
       Remove this file, .nuget-local/ and the pinned version when upstream publishes Ref for net472 again. See Docs/runs/2026-11-19-pickle-6.7.5-analysis.md. -->
  <packageSources>
    <add key="pickle-ref-local" value=".nuget-local" />
  </packageSources>
</configuration>
